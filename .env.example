# Required secrets and application settings
TG_BOT_TOKEN=
APP_ID=
API_HASH=
DATABASE_URL=
DATABASE_NAME=OnlyFapsFileShareBot
CHANNEL_ID=
OWNER=
OWNER_ID=
# Not required in the default Telegram mode. Only set this for SECURE_GATE_MODE=web.
BASE_URL=
BOT_USERNAME=YourBotUsername
PORT=8001

# Shortener providers. Set URL and API together for each enabled slot.
SHORTLINK_URL=
SHORTLINK_API=
SHORTLINK_URL_2=
SHORTLINK_API_2=
SHORTLINK_URL_3=
SHORTLINK_API_3=
SHORTLINK_URL_4=
SHORTLINK_API_4=
SHORTLINK_URL_5=
SHORTLINK_API_5=
SHORTLINK_URL_6=
SHORTLINK_API_6=

# Verification/security
SECURE_GATE_ENABLED=true
SECURE_GATE_MODE=telegram
SECURE_SESSION_TTL=1200
SECURE_GRANT_TTL=300
SECURE_CHALLENGE_MIN_SCORE=3
SECURE_BIND_USER=true
BYPASS_PROTECTION_SECONDS=90
SHORT_MSG_AUTO_DELETE_SECONDS=1200
FSUB_LINK_EXPIRY=3000
